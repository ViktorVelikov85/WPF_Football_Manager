<Window x:Class="WPF_Football_Manager.UI.ClubsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Отбори"
        Width="798"
        Height="718"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        FontFamily="Segoe UI"
        Loaded="Window_Loaded">

    <Canvas>
        <!-- Таблица с отборите -->
        <DataGrid x:Name="dgvClubs"
                  Canvas.Left="12"
                  Canvas.Top="12"
                  Width="753"
                  Height="448"
                  FontFamily="Arial"
                  FontSize="16"
                  RowHeight="30"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  CanUserResizeColumns="False"
                  CanUserResizeRows="False"
                  HeadersVisibility="Column"
                  SelectionMode="Single"
                  SelectionUnit="FullRow"
                  SelectionChanged="dgvClubs_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Име на отбор"
                                    Binding="{Binding name}"
                                    Width="*" />
                <DataGridTextColumn Header="Град"
                                    Binding="{Binding city}"
                                    Width="200" />
                <DataGridTextColumn Header="Стадион"
                                    Binding="{Binding stadium}"
                                    Width="*" />
                <DataGridTextColumn Header="Година на откриване"
                                    Binding="{Binding founded_year}"
                                    Width="180" />
            </DataGrid.Columns>
        </DataGrid>

        <!-- Етикет и поле: Име на отбор -->
        <TextBlock x:Name="label1"
                   Text="Име на отбор"
                   FontSize="19"
                   Canvas.Left="12"
                   Canvas.Top="463" />

        <TextBox x:Name="txtName"
                 FontSize="19"
                 Canvas.Left="12"
                 Canvas.Top="491"
                 Width="381"
                 Height="33"
                 VerticalContentAlignment="Center" />

        <!-- Етикет и поле: Град -->
        <TextBlock x:Name="label2"
                   Text="Град"
                   FontSize="19"
                   Canvas.Left="12"
                   Canvas.Top="533" />

        <TextBox x:Name="txtCity"
                 FontSize="19"
                 Canvas.Left="12"
                 Canvas.Top="561"
                 Width="232"
                 Height="33"
                 VerticalContentAlignment="Center" />

        <!-- Етикет и поле: Стадион -->
        <TextBlock x:Name="label3"
                   Text="Стадион"
                   FontSize="19"
                   Canvas.Left="12"
                   Canvas.Top="605" />

        <TextBox x:Name="txtStadium"
                 FontSize="19"
                 Canvas.Left="12"
                 Canvas.Top="633"
                 Width="230"
                 Height="33"
                 VerticalContentAlignment="Center" />

        <!-- Етикет и поле: Година на откриване -->
        <TextBlock x:Name="label4"
                   Text="Година на откриване"
                   FontSize="19"
                   Canvas.Left="415"
                   Canvas.Top="463" />

        <TextBox x:Name="txtCreatedIn"
                 FontSize="19"
                 Canvas.Left="458"
                 Canvas.Top="491"
                 Width="100"
                 Height="33"
                 VerticalContentAlignment="Center" />

        <!-- Бутон Изчисти -->
        <Button x:Name="btnClear"
                Content="Изчисти"
                FontSize="19"
                Canvas.Left="273"
                Canvas.Top="607"
                Width="120"
                Height="60"
                Click="btnClear_Click" />

        <!-- Бутон Добави -->
        <Button x:Name="btnAdd"
                Content="Добави"
                Background="LightGreen"
                FontSize="19"
                Canvas.Left="645"
                Canvas.Top="475"
                Width="120"
                Height="60"
                Click="btnAdd_Click" />

        <!-- Бутон Изтрий -->
        <Button x:Name="btnDelete"
                Content="Изтрий"
                Background="Coral"
                FontSize="19"
                Canvas.Left="645"
                Canvas.Top="541"
                Width="120"
                Height="60"
                Click="btnDelete_Click" />

        <!-- Бутон Обнови -->
        <Button x:Name="btnEdit"
                Content="Обнови"
                Background="LightBlue"
                FontSize="19"
                Canvas.Left="645"
                Canvas.Top="607"
                Width="120"
                Height="60"
                Click="btnEdit_Click" />
    </Canvas>
</Window>