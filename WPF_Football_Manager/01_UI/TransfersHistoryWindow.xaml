<Window x:Class="WPF_Football_Manager.UI.TransfersHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="История на трансферите"
        Width="844"
        Height="525"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        FontFamily="Segoe UI"
        Loaded="Window_Loaded">

    <Canvas>
        <!-- Заглавие -->
        <TextBlock x:Name="label1"
                   Text="История на трансферите"
                   FontFamily="Segoe UI Semibold"
                   FontSize="24"
                   FontWeight="Bold"
                   TextAlignment="Center"
                   Canvas.Left="12"
                   Canvas.Top="9"
                   Width="804"
                   Height="32" />

        <!-- Етикет за търсене -->
        <TextBlock x:Name="label2"
                   Text="Търси играч по име"
                   FontSize="19"
                   Canvas.Left="12"
                   Canvas.Top="42" />

        <!-- Поле за търсене -->
        <TextBox x:Name="txtSearchNameTransfer"
                 FontSize="19"
                 Canvas.Left="12"
                 Canvas.Top="70"
                 Width="254"
                 Height="33"
                 VerticalContentAlignment="Center"
                 TextChanged="txtSearchNameTransfer_TextChanged" />

        <!-- Таблица с историята на трансферите -->
        <DataGrid x:Name="dgvTransfers"
                  Canvas.Left="12"
                  Canvas.Top="122"
                  Width="804"
                  Height="352"
                  FontFamily="Arial"
                  FontSize="16"
                  RowHeight="30"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  CanUserResizeColumns="False"
                  CanUserResizeRows="False"
                  HeadersVisibility="Column"
                  SelectionMode="Single"
                  SelectionUnit="FullRow">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Играч"
                                    Binding="{Binding player_name}"
                                    Width="*" />

                <DataGridTextColumn Header="Стар отбор"
                                    Binding="{Binding old_club_name}"
                                    Width="*" />

                <DataGridTextColumn Header="Нов отбор"
                                    Binding="{Binding new_club_name}"
                                    Width="*" />

                <DataGridTextColumn Header="Сума (€)"
                                    Binding="{Binding transfer_fee, StringFormat={}{0:#,##0} €}"
                                    Width="120">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment"
                                    Value="Right" />
                            <Setter Property="VerticalAlignment"
                                    Value="Center" />
                            <Setter Property="Margin"
                                    Value="0,0,6,0" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <DataGridTextColumn Header="Дата"
                                    Binding="{Binding transfer_date, StringFormat=dd.MM.yyyy}"
                                    Width="120">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment"
                                    Value="Center" />
                            <Setter Property="VerticalAlignment"
                                    Value="Center" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Canvas>
</Window>