<Window x:Class="WPF_Football_Manager.UI.PlayersStatisticsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Статистика"
        Width="1638"
        Height="553"
        Background="#F5F7FA"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        FontFamily="Segoe UI"
        Loaded="Window_Loaded">

    <Canvas>
        <!-- Заглавие и контейнер: Най-много голове -->
        <TextBlock x:Name="label1"
                   Text="Най-много голове"
                   Foreground="#2B303A"
                   FontSize="18"
                   FontWeight="Bold"
                   Canvas.Left="192"
                   Canvas.Top="9" />

        <Canvas x:Name="canvasPodium"
                Canvas.Left="12"
                Canvas.Top="58"
                Width="485"
                Height="425" />

        <!-- Заглавие и контейнер: Най-много картони -->
        <TextBlock x:Name="label2"
                   Text="Най-много картони"
                   Foreground="#2B303A"
                   FontSize="18"
                   FontWeight="Bold"
                   Canvas.Left="735"
                   Canvas.Top="9" />

        <Canvas x:Name="canvasMostCards"
                Canvas.Left="551"
                Canvas.Top="58"
                Width="547"
                Height="425" />

        <!-- Заглавие и контейнер: Най-много фалове -->
        <TextBlock x:Name="label3"
                   Text="Най-много фалове"
                   Foreground="#2B303A"
                   FontSize="18"
                   FontWeight="Bold"
                   Canvas.Left="1292"
                   Canvas.Top="9" />

        <Canvas x:Name="canvasMostFouls"
                Canvas.Left="1154"
                Canvas.Top="58"
                Width="456"
                Height="425" />
    </Canvas>
</Window>