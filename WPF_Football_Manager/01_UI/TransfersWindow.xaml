<Window x:Class="WPF_Football_Manager.UI.TransfersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Трансфер на играч"
        Width="882"
        Height="607"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        FontFamily="Segoe UI"
        Loaded="Window_Loaded">

    <Canvas>
        <!-- Търсене по име на играч -->
        <TextBlock x:Name="label6"
                   Text="Търси по име на играч"
                   FontSize="19"
                   Canvas.Left="31"
                   Canvas.Top="9" />

        <TextBox x:Name="txtSearchNameTransfer"
                 FontSize="19"
                 Canvas.Left="31"
                 Canvas.Top="37"
                 Width="272"
                 Height="33"
                 VerticalContentAlignment="Center"
                 TextChanged="txtSearchNameTransfer_TextChanged" />

        <!-- Заглавие над таблицата -->
        <TextBlock x:Name="label7"
                   Text="Предишни трансфери"
                   FontSize="19"
                   Canvas.Left="326"
                   Canvas.Top="62" />

        <!-- Таблица с предишни трансфери -->
        <DataGrid x:Name="dgvTransfers"
                  Canvas.Left="12"
                  Canvas.Top="90"
                  Width="842"
                  Height="248"
                  FontFamily="Arial"
                  FontSize="16"
                  RowHeight="30"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  CanUserResizeColumns="False"
                  CanUserResizeRows="False"
                  HeadersVisibility="Column"
                  SelectionMode="Single"
                  SelectionUnit="FullRow">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Играч"
                                    Binding="{Binding player_name}"
                                    Width="*" />

                <DataGridTextColumn Header="Стар отбор"
                                    Binding="{Binding old_club_name}"
                                    Width="*" />

                <DataGridTextColumn Header="Нов отбор"
                                    Binding="{Binding new_club_name}"
                                    Width="*" />

                <DataGridTextColumn Header="Сума (€)"
                                    Binding="{Binding transfer_fee, StringFormat={}{0:#,##0} €}"
                                    Width="120">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment"
                                    Value="Right" />
                            <Setter Property="VerticalAlignment"
                                    Value="Center" />
                            <Setter Property="Margin"
                                    Value="0,0,6,0" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <DataGridTextColumn Header="Дата"
                                    Binding="{Binding transfer_date, StringFormat=dd.MM.yyyy}"
                                    Width="120">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment"
                                    Value="Center" />
                            <Setter Property="VerticalAlignment"
                                    Value="Center" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Име на играч -->
        <TextBlock x:Name="label1"
                   Text="Име на играч"
                   FontSize="19"
                   Canvas.Left="12"
                   Canvas.Top="341" />

        <TextBox x:Name="txtPlayer"
                 FontSize="19"
                 IsReadOnly="True"
                 Canvas.Left="12"
                 Canvas.Top="368"
                 Width="272"
                 Height="33"
                 VerticalContentAlignment="Center" />

        <!-- Такса € -->
        <TextBlock x:Name="label4"
                   Text="Такса €"
                   FontSize="19"
                   Canvas.Left="312"
                   Canvas.Top="341" />

        <TextBox x:Name="txtFee"
                 Text="0"
                 FontSize="19"
                 Canvas.Left="312"
                 Canvas.Top="369"
                 Width="172"
                 Height="33"
                 VerticalContentAlignment="Center" />

        <!-- От отбор -->
        <TextBlock x:Name="label2"
                   Text="От отбор"
                   FontSize="19"
                   Canvas.Left="12"
                   Canvas.Top="409" />

        <TextBox x:Name="txtFromClub"
                 FontSize="19"
                 IsReadOnly="True"
                 Canvas.Left="12"
                 Canvas.Top="437"
                 Width="274"
                 Height="33"
                 VerticalContentAlignment="Center" />

        <!-- Към отбор -->
        <TextBlock x:Name="label3"
                   Text="Към отбор"
                   FontSize="19"
                   Canvas.Left="312"
                   Canvas.Top="409" />

        <ComboBox x:Name="cboToClub"
                  FontSize="19"
                  Canvas.Left="312"
                  Canvas.Top="437"
                  Width="259"
                  Height="33"
                  VerticalContentAlignment="Center" />

        <!-- Дата на трансфер -->
        <TextBlock x:Name="label5"
                   Text="Дата на трансфер"
                   FontSize="19"
                   Canvas.Left="12"
                   Canvas.Top="477" />

        <DatePicker x:Name="dtpTransferDate"
                    FontSize="19"
                    Canvas.Left="12"
                    Canvas.Top="505"
                    Width="219"
                    Height="33"
                    VerticalContentAlignment="Center" />

        <!-- Бутон Трансфер -->
        <Button x:Name="btnTransfer"
                Content="Трансфер"
                Background="LightGreen"
                FontSize="19"
                Canvas.Left="734"
                Canvas.Top="409"
                Width="120"
                Height="60"
                Click="btnTransfer_Click" />

        <!-- Бутон Изчисти -->
        <Button x:Name="btnClear"
                Content="Изчисти"
                FontSize="19"
                Canvas.Left="734"
                Canvas.Top="493"
                Width="120"
                Height="60"
                Click="btnClear_Click" />
    </Canvas>
</Window>